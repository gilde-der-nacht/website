---
import BaseLayout from "@common/layouts/BaseLayout.astro";
import "/gildedernacht.ch/styles/main.scss";

const { locale, title, metaTitle, description, keywords, toc } =
  Astro.props.frontmatter ?? Astro.props;
const { headings } = Astro.props;

const siteName = "Gilde der Nacht";
const siteCode = "gdn";
const siteTagline = "Luzerner Spielverein";

const pages = Object.values(import.meta.glob("../pages/**/*", { eager: true }));
---

<BaseLayout
  locale={locale}
  title={title}
  metaTitle={[metaTitle, siteName].filter(Boolean).join(" | ")}
  description={description}
  keywords={keywords}
  siteCode={siteCode}
  siteName={siteName}
  siteTagline={siteTagline}
  pages={pages}
  headings={headings}
  toc={toc ?? null}
  development={false}
>
  <slot />
</BaseLayout>
