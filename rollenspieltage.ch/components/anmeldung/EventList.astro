---
import type { ProgramEntryClient} from '@rst/components/anmeldung/api/program';
import { TXT } from '@rst/components/anmeldung/constant/texts';
import { gameTags } from '@rst/components/anmeldung/constant/tags';

export type Props = {
  hour: string;
  entries: ProgramEntryClient[];
}

const { hour, entries } = Astro.props;
const colorsOfHour: Record<string, string> = {
  "10": "special",
  "11": "success",
  "14": "danger",
  "15": "special",
  "19": "success"
}
---

<ul class="event-list" role="list"> 
{
  entries.map((entry) =>{
  const tagNames = gameTags
    .filter((g) => entry.tags.includes(g.name))
    .map(({ label }) => label);

  return  (
    <li class=`event-entry ${colorsOfHour[hour]}`>
      <h3 class="event-title">{entry.title}</h3>
      <div class="event-details"> 
        <div class="event-tags"><strong>Spielleitung:</strong> {entry.gamemaster}</div> 
        <div class="event-tags">
          <strong>System:</strong>
          {entry.system.trim().length > 0 ? (
            entry.system
          ) : (
            <em>kein System angegeben</em>
          )}
        </div>
        <div class="event-tags">
          <strong>Tag, Zeit:</strong>
          <span>
            {TXT.days[entry.slot.day]}, {entry.slot.from} -{" "}
            {entry.slot.to} Uhr
          </span>
        </div>
        <div class="event-tags"><strong>Spielende:</strong> {entry.playerCount.max > 50 ? (
        <em>unbegrenzt</em>
        ) : (
        `${entry.playerCount.min} - ${entry.playerCount.max}`
        )}
        </div> 
        <div class="event-tags">
          <strong>Kategorien:</strong>{" "}
          {tagNames.length > 0 ? (
            tagNames.join(", ")
          ) : (
            <em>keine Kategorien</em>
          )}
        </div>
      </div>
      {
        entry.description !== null && entry.description.short.trim().length > 0 ? (
          <div class="event-description content"><p><strong>Beschreibung:</strong><br/>{entry.description.short}</p> </div>
        ) : null
      }
    </li>
  )})

}
{
  entries.length < 3 && entries.length > 0 ? (
    <li class=`event-entry gray`>
      <h3 class="event-title">Möchtest du auch eine Spielrunde leiten?</h3>
      <div></div>
      <div class="event-description content"><p>Melde dich ungeniert bei uns.</p><p>Sollest du noch wenig bis gar keine Erfahrung mit dem Leiten von Rollenspielrunden haben, dann unterstützen wir dich gerne vor und während dem Anlass.</p> </div>                           
      <ul role="list" class="event-links"> <li><a href="https://rollenspieltage.ch/kontakt" class="event-link"> Zum Kontaktformular</a></li>  </ul>
    </li>
  ) : null
}
</ul>

