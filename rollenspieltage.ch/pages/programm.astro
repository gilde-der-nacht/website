---
import Layout from "@rst/layouts/Layout.astro";
import { Button } from "@common/components/Button.tsx";
import EventList from "@rst/components/anmeldung/EventList.astro";
import { MealBreak } from "@rst/components/anmeldung/MealBreak.tsx";
import {
  loadProgram,
  groupByDay,
  sortByFromHour,
} from "@rst/components/anmeldung/api/program";
import { assert } from "@common/components/utils";

export const frontmatter = {
  navigation: {
    group: "main",
    label: "Programm",
    order: 1,
  },
};

const programRequest = await loadProgram();
assert(programRequest.kind === "SUCCESS", "loadProgram failed");
const programList =
  programRequest.kind === "SUCCESS" ? programRequest.data : [];

const program = sortByFromHour(groupByDay(programList));
const saturday = Object.entries(program.SATURDAY).filter(
  ([_, entries]) => entries.length > 0,
);
const sunday = Object.entries(program.SUNDAY).filter(
  ([_, entries]) => entries.length > 0,
);
---

<Layout metaTitle="Programm 2025">
  <h1 id="programm-2025">
    <a href="#programm-2025" class="header-anchor">Programm 2025</a>
  </h1>

  <a href="#Samstag" style="border: none;"><Button label="Samstag" /></a>
  <a href="#Sonntag" style="border: none;"><Button label="Sonntag" /></a>

  <h2 id="Samstag">
    <a href="#Samstag" class="header-anchor">Samstag, 23. August 2025</a>
  </h2>
  {
    saturday
      .filter(([hour]) => {
        return Number(hour) < 13;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Samstag-${hour}`}>
            <a href={`#Samstag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} />
        </>
      ))
  }

  <div style="margin-block: 2.5rem;">
    <MealBreak type="LUNCH" />
  </div>

  {
    saturday
      .filter(([hour]) => {
        return Number(hour) > 13 && Number(hour) < 18;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Samstag-${hour}`}>
            <a href={`#Samstag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} />
        </>
      ))
  }

  <div style="margin-block: 2.5rem;">
    <MealBreak type="DINNER" />
  </div>

  {
    saturday
      .filter(([hour]) => {
        return Number(hour) > 18;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Samstag-${hour}`}>
            <a href={`#Samstag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} />
        </>
      ))
  }
  <a href="#top" style="border: none;"><Button label="nach oben" /></a>

  <h2 id="Sonntag">
    <a href="#Sonntag" class="header-anchor">Sonntag, 24. August 2025</a>
  </h2>

  {
    sunday
      .filter(([hour]) => {
        return Number(hour) < 13;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Sonntag-${hour}`}>
            <a href={`#Sonntag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} />
        </>
      ))
  }

  <div style="margin-block: 2.5rem;">
    <MealBreak type="LUNCH" />
  </div>

  {
    sunday
      .filter(([hour]) => {
        return Number(hour) > 13;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Sonntag-${hour}`}>
            <a href={`#Sonntag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} />
        </>
      ))
  }

  <a href="#top" style="border: none;"><Button label="nach oben" /></a>
</Layout>
