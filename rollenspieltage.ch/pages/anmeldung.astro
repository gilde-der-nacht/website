---
import Layout from "@rst/layouts/Layout.astro";
import { Anmeldung as A } from "@rst/components/anmeldung/pages/Anmeldung.tsx";
import { Box } from "@common/components/Box";
import { Button } from "@common/components/Button";

export const frontmatter = {
  navigation: {
    group: "main",
    label: "Anmeldung",
    order: 10,
  },
};
---

<Layout metaTitle="Anmeldung">
  <h1>Anmeldung</h1>

  <div style="margin-block: 2.5rem;" hidden>
    <a href="/programm" style="border: none;">
      <Button label="Zur Spielrunden-Übersicht" onClick={() => {}} />
    </a>
  </div>

  <Box>
    <p>
      Falls du bereits eine Anmeldung begonnen hast, dann solltest du eine
      E-Mail mit einem persönlichen Link erhalten haben. Dieser erlaubt es dir
      deine Anmeldung anzupassen.
    </p>
  </Box>

  <A client:load />
  <div style="margin-block: 2.5rem;">
    <Box type="special">
      <p>
        Deine persönlichen Daten werden ausschliesslich für die Luzerner
        Rollenspieltage 2026 verwendet.
      </p>
      <br />
      <p>
        Möchtest du auch nach dem Event über Anlässe von uns informiert werden,
        dann empfehlen wir dir, unseren
        <a href="/newsletter">Newsletter zu abonnieren</a>.
      </p>
    </Box>
  </div>
</Layout>
