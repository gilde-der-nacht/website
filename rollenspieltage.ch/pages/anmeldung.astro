---
import Layout from "@rst/layouts/Layout.astro";
import { AnmeldungWrapper } from "@rst/components/anmeldung/pages/RegistrationPage.tsx";
import { Box } from "@common/components/Box";

export const frontmatter = {
  navigation: {
    group: "main",
    label: "Anmeldung 2025",
    order: 2,
  },
};
---

<Layout metaTitle="Anmeldung">
  <h1>Anmeldung 2025</h1>
  <AnmeldungWrapper client:load />
  <Box type="special">
    <p>
      Deine persönlichen Daten werden ausschliesslich verwendet, um dich über
      das Programm der Luzerner Rollenspieltage 2025 zu informieren. Nach dem
      Event werden diese gelöscht.
    </p>
    <p>
      Möchtest du auch nach dem Event über Anlässe von uns informiert werden,
      dann empfehlen wir dir, unseren
      <a href="/newsletter">Newsletter zu abonnieren</a>.
    </p>
  </Box>
</Layout>
