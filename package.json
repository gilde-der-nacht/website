{
  "$schema": "https://json.schemastore.org/package",
  "name": "dandelion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "gdn-dev": "astro --config ./gildedernacht.ch/config.ts dev",
    "gdn-build": "yarn build-ics && yarn check && astro --config ./gildedernacht.ch/config.ts build",
    "lst-dev": "astro --config ./spieltage.ch/config.ts dev",
    "lst-build": "yarn check && astro --config ./spieltage.ch/config.ts build",
    "rst-dev": "astro --config ./rollenspieltage.ch/config.ts dev",
    "rst-build": "yarn check && astro --config ./rollenspieltage.ch/config.ts build",
    "hhh-dev": "astro --config ./hhh.gildedernacht.ch/config.ts dev",
    "hhh-build": "yarn check && astro --config ./hhh.gildedernacht.ch/config.ts build",
    "build-ics": "tsx ./gildedernacht.ch/build.ts",
    "check": "tsc --noEmit && prettier . --check",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "8",
    "@astrojs/solid-js": "7.1.6",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@astrojs/ts-plugin": "^1.11.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@sentry/browser": "11",
    "@solidjs/router": "1.0.3",
    "@types/html-escaper": "^3.0.4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.11",
    "astro": "7.4.13",
    "core-js": "3.51.0",
    "luxon": "^3.7.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-smartypants": "^3.0.3",
    "sass": "^1.108.2",
    "solid-js": "1.9.20",
    "tsx": "^4.23.15",
    "typescript": "7",
    "vite": "8",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
