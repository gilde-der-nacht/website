---
import type { ProgramList } from '@lst/components/anmeldung/data.ts';

export type Props = {
  hour: string;
  entries: ProgramList;
  showQuestion: boolean;
}

const { hour, entries, showQuestion} = Astro.props;
const colorsOfHour: Record<string, string> = {
  "10": "special",
  "11": "success",
  "14": "danger",
  "15": "special",
  "19": "success"
}
---

<ul class="event-list" role="list"> 
{
  entries.map((entry) => (
    <li class=`event-entry ${colorsOfHour[hour]}`>
      <h1 class="event-title">{entry.title}</h1>
      <div class="event-details"> 
        <div class="event-tags"><strong>Zeit:</strong> {entry.slot.start} - {entry.slot.end} Uhr</div> 
        <div class="event-tags"><strong>Spielleitung:</strong> {entry.master_name}</div> 
        {
          entry.external_link === null ? null : (
            <div class="event-tags"><strong>Link:</strong> <a href={entry.external_link.link} style="border: none;">{entry.external_link.label}</a></div>
          )
        }
        <div class="event-tags"><strong>Spielende:</strong> {entry.playercount.max > 50 ? (
        <em>unbegrenzt</em>
        ) : (
        `${entry.playercount.min} - ${entry.playercount.max}`
        )}
        </div> 
      </div>
      {
        entry.description !== null && entry.description.trim().length > 0 ? (
          <div class="event-description content"><p><strong>Beschreibung:</strong><br/>{entry.description}</p> </div>
        ) : null
      }
    </li>
  ))
}
{
  showQuestion ? (
    <li class=`event-entry gray`>
      <h3 class="event-title">Möchtest du auch eine Spielrunde leiten?</h3>
      <div></div>
      <div class="event-description content"><p>Melde dich ungeniert bei uns.</p> </div>                           
      <ul role="list" class="event-links"> <li><a href="/kontakt" class="event-link"> Zum Kontaktformular</a></li>  </ul>
    </li>
  ) : null
}
</ul>

