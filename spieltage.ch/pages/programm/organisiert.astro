---
import Layout from "@lst/layouts/Layout.astro";
import { Button } from "@common/components/Button.tsx";
import { getProgramGroupedByStarthour } from "@lst/components/anmeldung/data.ts";
import EventList from "@lst/components/anmeldung/EventList.astro";

const program = await getProgramGroupedByStarthour();
const saturday = Object.entries(program.SATURDAY);
const sunday = Object.entries(program.SUNDAY);
---

<Layout metaTitle="Programm 2025">
  <h1 id="programm-2025">
    <a href="#programm-2025" class="header-anchor">Organisierte Spielerunden</a>
  </h1>

  <a href="#Samstag" style="border: none;"><Button label="Samstag" /></a>
  <a href="#Sonntag" style="border: none;"><Button label="Sonntag" /></a>

  <p style="margin-block-start: 2.5rem;">
    Wir veranstalten diverse Spielrunden, die für Action und Spannung stehen.
    Komplexe oder tumultreiche Spiele, so wie Spiele mit hoher Spieleranzahl
    finden so ihren Platz. Das ist auch eine gute Gelegenheit, andere
    Mitspieler:innen zu finden, wenn du alleine anreist.
  </p>
  <p>Du kannst dir hier bereits im Vorfeld einen Platz sichern!</p>
  <p>
    <i>
      Hast du selbst ein Spiel, welches du für eine Gruppe anbiten möchtest?
      Dann kontaktiere uns via Kontaktformular.
    </i>
  </p>

  <div style="margin-block: 2.5rem;">
    <a href="/anmeldung" style="border: none;">
      <Button label="Zur Anmeldung" />
    </a>
  </div>

  <h2 id="Samstag">
    <a href="#Samstag" class="header-anchor">Samstag, 22. März 2025</a>
  </h2>
  {
    saturday
      .filter(([hour]) => {
        return Number(hour) < 13;
      })
      .map(([hour, entries], i) => (
        <>
          <h3 id={`Samstag-${hour}`}>
            <a href={`#Samstag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} showQuestion={i === 0} />
        </>
      ))
  }

  <div style="margin-block: 2.5rem;">
    <a href="/anmeldung" style="border: none;">
      <Button label="Zur Anmeldung" />
    </a>
  </div>

  {
    saturday
      .filter(([hour]) => {
        return Number(hour) > 13 && Number(hour) < 18;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Samstag-${hour}`}>
            <a href={`#Samstag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} showQuestion={false} />
        </>
      ))
  }

  <div style="margin-block: 2.5rem;">
    <a href="/anmeldung" style="border: none;">
      <Button label="Zur Anmeldung" />
    </a>
  </div>

  {
    saturday
      .filter(([hour]) => {
        return Number(hour) > 18;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Samstag-${hour}`}>
            <a href={`#Samstag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} showQuestion={false} />
        </>
      ))
  }
  <a href="#top" style="border: none;"><Button label="nach oben" /></a>

  <h2 id="Sonntag">
    <a href="#Sonntag" class="header-anchor">Sonntag, 23. März 2025</a>
  </h2>

  {
    sunday
      .filter(([hour]) => {
        return Number(hour) < 13;
      })
      .map(([hour, entries], i) => (
        <>
          <h3 id={`Sonntag-${hour}`}>
            <a href={`#Sonntag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} showQuestion={i === 0} />
        </>
      ))
  }

  <div style="margin-block: 2.5rem;">
    <a href="/anmeldung" style="border: none;">
      <Button label="Zur Anmeldung" />
    </a>
  </div>

  {
    sunday
      .filter(([hour]) => {
        return Number(hour) > 13;
      })
      .map(([hour, entries]) => (
        <>
          <h3 id={`Sonntag-${hour}`}>
            <a href={`#Sonntag-${hour}`} class="header-anchor">
              Start {hour} Uhr
            </a>
          </h3>
          <EventList hour={hour} entries={entries} showQuestion={false} />
        </>
      ))
  }

  <a href="#top" style="border: none;"><Button label="nach oben" /></a>
</Layout>
