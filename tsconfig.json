{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "paths": {
      "@common/*": [
        "./common/*"
      ],
      "@registration/*": [
        "./common/registration/*"
      ],
      "@gdn/*": [
        "./gildedernacht.ch/*"
      ],
      "@lst/*": [
        "./spieltage.ch/*"
      ],
      "@rst/*": [
        "./rollenspieltage.ch/*"
      ],
      "@hhh/*": [
        "./hhh.gildedernacht.ch/*"
      ]
    },
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  }
}